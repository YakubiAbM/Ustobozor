# Скопируйте как .env на сервере: cp .env.example .env
# В репозиторий коммитить только этот файл, НЕ .env

# БД (в Docker Compose переопределяется на db:5432)
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@db:5432/market

# Супер-админ
SUPERADMIN_PHONE_NORM=986505650
SUPERADMIN_PASSWORD=

SKIP_ADMIN_AUTH=0
DEBUG=false
# Dev only (с DEBUG=true): POST /auth/dev-login — вход без OTP
SKIP_MASTER_OTP=0

# OTP: prod = redis через Docker; dev = memory
REDIS_URL=redis://redis:6379/0
OTP_BACKEND=redis

# Alif SMS (резерв)
ALIF_SMS_API_KEY=

# --- Защита от SMS/Gateway-флуда и bruteforce ---
# Макс. запросов кода на один номер за окно (не по IP!)
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=900
# TTL одноразового кода (сек)
OTP_TTL_SECONDS=300
# Макс. неверных вводов кода подряд → блокировка номера
OTP_VERIFY_MAX_ATTEMPTS=3
# Блокировка номера после bruteforce (сек): 1800 = 30 мин
OTP_BLOCK_SECONDS=1800

# JWT (prod: длинный случайный секрет)
JWT_SECRET=change-me-in-production-use-long-secret

# CORS для Web/PWA (через запятую)
ALLOWED_ORIGINS=https://ustobozor.tj,https://www.ustobozor.tj

# Публичный URL (ссылки в PWA, APK и т.д.)
PUBLIC_BASE_URL=https://ustobozor.tj
