# Скопируйте на сервере: cp .env.example .env && nano .env
# Или локально: python3 scripts/generate_prod_env.py
# Реальные пароли НЕ коммитить — только в .env (gitignore).

# Postgres (должен совпадать с POSTGRES_PASSWORD и docker-compose)
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/market

# Супер-админ (вход в /admin и админку приложения)
SUPERADMIN_PHONE_NORM=987654321
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

SKIP_ADMIN_AUTH=0
DEBUG=false
SKIP_MASTER_OTP=0

# OTP: prod = redis через Docker; dev = memory
REDIS_URL=redis://redis:6379/0
OTP_BACKEND=redis
ALIF_SMS_API_KEY=
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=900
OTP_TTL_SECONDS=300
OTP_VERIFY_MAX_ATTEMPTS=3
OTP_BLOCK_SECONDS=1800

# JWT (prod: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# CORS / публичный URL
ALLOWED_ORIGINS=https://ustomarket.tj,https://www.ustomarket.tj
PUBLIC_BASE_URL=https://ustomarket.tj
